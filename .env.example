# ============================================================
# Plantilla de entorno — copiar a .env y completar valores reales
#   cp .env.example .env   &&   openssl rand -hex 32
# .env NUNCA se sube a git (ver .gitignore)
# ============================================================

# --- Dominio y puertos (red interna) ---
PORTAL_DOMAIN=portal.rr.local
HTTP_PORT=80
HTTPS_PORT=443
# Puerto de acceso directo a Directus (solo localhost; externo vía Caddy)
DIRECTUS_PORT=8055

# --- Versiones (fijar versión exacta para producción) ---
DIRECTUS_VERSION=latest

# --- PostgreSQL ---
POSTGRES_DB=comandosrr
POSTGRES_USER=directus
POSTGRES_PASSWORD=cambiar-contrasena-postgres

# --- Directus ---
# Generar con: openssl rand -hex 32
DIRECTUS_KEY=cambiar-key
DIRECTUS_SECRET=cambiar-secret
# Debe ser un email con TLD real válido (Joi rechaza .local, .test, etc.)
DIRECTUS_ADMIN_EMAIL=admin@capacitacion-rr.co
DIRECTUS_ADMIN_PASSWORD=cambiar-contrasena-admin

# --- Frontend (Fase 2) ---
# URL que usa el SERVIDOR Next.js para hablar con Directus. Se lee en cada
# petición, no se compila: se puede cambiar sin `npm run build`.
DIRECTUS_URL=https://portal.rr.local
# Solo para lo que llega al navegador; se incrusta al compilar, así que
# cambiarla obliga a `npm run build`. Los videos se sirven por el mismo
# origen (rewrite /assets), no por esta URL.
NEXT_PUBLIC_DIRECTUS_URL=https://portal.rr.local
# Cuenta de servicio de solo lectura que usa el frontend para leer el
# contenido (Directus 12 no tiene tokens estáticos: el servidor inicia
# sesión con esta cuenta). La contraseña la imprime `npm run setup:access`.
DIRECTUS_SERVICE_EMAIL=portal@capacitacion-rr.co
DIRECTUS_SERVICE_PASSWORD=

# Vida de la sesión de servicio (docker-compose). Con 1d + refresh del
# SDK la sesión se renueva sola, así que no hay que hacer nada.
DIRECTUS_ACCESS_TOKEN_TTL=1d
DIRECTUS_REFRESH_TOKEN_TTL=30d
DIRECTUS_SESSION_COOKIE_TTL=1d

# JWT Secret para firmar tokens de autenticación (mínimo 32 chars)
# Generar con: openssl rand -hex 32
JWT_SECRET=

# Cookies de sesión con bandera Secure (solo se envían por HTTPS).
# Vacío = Secure en producción y no en desarrollo, que sale del build y
# por eso no sirve para saber cómo se publica: el build SIEMPRE es
# "production". Poner true tras el Caddy de HTTPS; false cuando el
# portal se sirva por HTTP plano, que si no el login parece funcionar
# y la cookie no vuelve en la petición siguiente.
#COOKIE_SECURE=true

# --- Usuario editor de prueba (scripts/setup-access.mjs y verify.mjs) ---
EDITOR_TEST_EMAIL=editor@empresa.co
EDITOR_TEST_PASSWORD=cambiar-contrasena-editor
